{
  "name": "r2share",
  "version": "1.0.0",
  "private": true,
  "description": "零费用的 R2 我的仓库：Cloudflare Worker + R2 公开桶直链",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "gen-config": "node scripts/gen-config.mjs",
    "deploy": "node scripts/gen-config.mjs && npm run check && wrangler deploy --config wrangler.deploy.toml",
    "check": "node scripts/check-deploy.mjs",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test-crypto": "node scripts/test-crypto.mjs",
    "test-mode": "node scripts/test-mode.mjs",
    "test-store": "node scripts/test-store.mjs",
    "test-preview": "node scripts/test-preview.mjs",
    "test-frontend": "node scripts/test-frontend.mjs",
    "test-routes": "node --import ./scripts/_ts-loader-register.mjs scripts/test-routes.mjs",
    "test": "node scripts/test-crypto.mjs && node scripts/test-mode.mjs && node scripts/test-store.mjs && node scripts/test-preview.mjs && node scripts/test-frontend.mjs && npm run test-routes",
    "push:gh": "bash scripts/push-gh.sh",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.1"
  }
}
